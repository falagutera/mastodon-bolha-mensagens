# Your instance. Only its accounts have a page.
JUSTMYTOOTS_INSTANCE=https://example.social

# Where this app is served, always https.
JUSTMYTOOTS_BASE_URL=https://justmytoots.example.social

# OAuth application, see README.md.
JUSTMYTOOTS_CLIENT_ID=
JUSTMYTOOTS_CLIENT_SECRET=

# Signs the session cookie: openssl rand -hex 32
JUSTMYTOOTS_SECRET=

# Optional. Used when the browser asks for neither en nor pt.
#JUSTMYTOOTS_LANG=en
